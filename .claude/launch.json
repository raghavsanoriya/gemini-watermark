{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-export",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "out"
      ],
      "port": 4173
    },
    {
      "name": "pages-export",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/serve-pages-export.py",
        "--port",
        "4174"
      ],
      "port": 4174
    },
    {
      "name": "server",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}